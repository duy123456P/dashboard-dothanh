 "cond": [
  [
   "Điều kiện chung ĐL",
   "TB 03 & 009",
   "Chỉ áp dụng cho Đại lý ủy quyền đã ký Kế hoạch mua sỉ/bán lẻ 2026. DAC có thể tạm ngưng cấp hàng nếu tồn kho cuối tháng vượt KHBH 2 tháng. Mức thưởng đã gồm VAT/thuế TNCN."
  ],
  [
   "Hiệu quả Mua sỉ",
   "TB 03 & 009",
   "Tính theo xe ĐL đã thanh toán đủ 100% theo HĐ trong tháng/quý/năm; đối chiếu ngày 10 hàng tháng; được cấn trừ vào đơn hàng sau."
  ],
  [
   "Hiệu quả Bán lẻ & Hồ sơ",
   "TB 03 & 009",
   "Tính theo ngày xuất hóa đơn bán lẻ; đối chiếu ngày 20 (IZ) / ngày 15 (MISSU). Hồ sơ (cà vẹt/giấy hẹn + hóa đơn) gửi hckd@dothanhauto.com chậm nhất ngày 03 tháng sau."
  ],
  [
   "Điều kiện Bán lẻ Quý & Năm",
   "TB 03 & 009",
   "Thưởng Quý: đạt KHBH tối thiểu 75%/tháng trong 2 tháng bất kỳ của quý. Thưởng Năm: đạt tối thiểu 75%/tháng trong 9 tháng bất kỳ của năm."
  ],
  [
   "Bán lẻ đúng vùng & Chế tài",
   "TB 02/2026",
   "Phân vùng: Miền Bắc (16 tỉnh), Miền Trung–TN (9 tỉnh), Miền Nam (Lâm Đồng, Đồng Nai, TP.HCM), Miền Tây (6 tỉnh). Vi phạm lấn vùng: phạt 20.000.000 đ/xe, thu hồi chiết khấu, ngưng cấp hàng & thanh toán thưởng."
  ],
  [
   "Thưởng TVBH (Tháng & Năm)",
   "TB 03 & 009",
   "Hỗ trợ truyền thông tháng: 1,5tr/xe IZ & 1,2tr/xe MISSU. Thưởng năm: 0,5tr/xe IZ (lũy kế ≥26 xe) & 0,3tr/xe MISSU (lũy kế ≥20 xe), yêu cầu HĐLĐ tại điểm bán DAC tối thiểu 08 tháng."
  ],
  [
   "Xe Tập lái (XTL)",
   "TB 138 & 186",
   "Giá bán cuối cùng sau CTKM; không hưởng thêm chính sách ĐL; vẫn tính vào % KHBH. Thưởng TVBH 2.000.000 đ/xe + tặng 5 voucher × 5.000.000 đ cho thầy giáo/trường."
  ],
  [
   "Các dòng loại trừ",
   "TB 03 & 009",
   "Xe IZ Euro4 chỉ ghi nhận sản lượng, không hưởng mức thưởng tiền. Dòng JP120 và Daewoo không nằm trong khung chính sách Tháng/Quý/Năm này."
  ]
 ],
